# Salin file ini menjadi .env.local di komputer Anda (jangan di-commit),
# lalu isi nilainya dari Supabase: Project Settings > API.

# URL proyek Supabase, contoh: https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Kunci "anon public" Supabase (aman untuk browser karena dilindungi RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# CATATAN: JANGAN menaruh "service_role" key di sini atau di kode frontend.
